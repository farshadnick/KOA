KUBESPRAY_VERSION=2.27.0
IMAGE_ARCH=amd64
UBUNTU_VERSION=22.04

# download-all.sh style stages
SKIP_OS_REPOS=false
SKIP_PYPI=false
SKIP_CHARTS=false
IMAGE_WORKERS=2

# Images are pushed to Docker Registry v2. All files under data/outputs are
# immediately available through nginx; no separate file publish is required.
PUSH_TO_REGISTRY=true
SAVE_IMAGE_TARS=true
