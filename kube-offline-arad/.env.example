KUBESPRAY_VERSION=2.27.0
IMAGE_ARCH=amd64
UBUNTU_VERSION=22.04

REGISTRY_PORT=35000
HTTP_PORT=8080
APP_PORT=8000

# LAN IP/hostname used in generated offline.yml (target nodes reach these)
REGISTRY_PUBLIC_HOST=192.168.1.10:35000
HTTP_PUBLIC_URL=http://192.168.1.10:8080

# Optional Mattermost after-hours bot (enable with --profile mattermost).
MATTERMOST_URL=https://mattermost.example.com
MATTERMOST_BOT_TOKEN=replace-with-bot-access-token
GOOGLE_SHEET_ID=replace-with-google-spreadsheet-id
GOOGLE_SHEET_TAB=Support Hours
SHEET_REFRESH_SECONDS=300
MATTERMOST_BOT_LOG_LEVEL=INFO
